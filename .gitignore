# Ignore everything by default
/*

# Allowlist: essential repo files
!.gitignore
!README.md
!package.json
!package-lock.json

# Allowlist: website content
!site/
!site/**

# Allowlist: build/maintenance scripts
!scripts/
!scripts/**

# Allowlist: required Pages function
!functions/
!functions/api/
!functions/api/submit-form.js

# Security - Secrets and Credentials
.secrets/
*.key
*.pem
*.p12
*.pfx
.env*
secrets.*
credentials.json
service-account.json
*secret*
*apikey*

# Build artifacts that might contain secrets
.cache/
.output/
dist/
build/

# Logs that might contain sensitive data
*.log
logs/
