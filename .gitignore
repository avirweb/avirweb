# Ignore everything by default
/*

# Ignore crawler output (generated, not committed)
mirror-raw/

# Allowlist: essential repo files
!.gitignore
!README.md
!SECURITY.md
!MIGRATION-REPORT.md
!package.json
!package-lock.json

# Allowlist: documentation
!docs/
!docs/**

# Allowlist: website content
!site/
!site/**

# Allowlist: build/maintenance scripts
!scripts/
!scripts/**

# Allowlist: required Pages function
!functions/
!functions/api/
!functions/api/submit-form.js

# Allowlist: GitHub Actions workflows
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Security - Secrets and Credentials
.secrets/
*.key
*.pem
*.p12
*.pfx
.env*
secrets.*
credentials.json
service-account.json
*secret*
*apikey*

# Build artifacts that might contain secrets
.cache/
.output/
dist/
build/

# Logs that might contain sensitive data
*.log
logs/

# Test results (generated, not committed)
test-results/visual-regression/
